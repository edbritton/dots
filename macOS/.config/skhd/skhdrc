# fn keys to avoid: A, C, D, N
# 0x2B = comma
# 0x2C = forward slash

.load "wm.skhdrc"

.blacklist [
  "Final Cut Pro"
]

shift - escape : ~/.config/skhd/caps-toggle

lcmd - 0x2B [
  "GitHub"        : open -a "GitHub" "https://github.com/settings/profile"
  "HA"            : open -a "HA" "http://192.168.8.20/config"
  "PancakeSlicer" : skhd -k "cmd - p"
  "U1"            : open -a "U1" "http://192.168.8.71/firmware-config"
  * ~
]

fn - c [
  "U1" : open -a "U1" "http://192.168.8.71/webcam/player"
]

lcmd - return [
  * : { lsappinfo info -n "Terminal" 2>/dev/null | grep -q . && osascript -e 'tell app "Terminal" to do script "" activate'; } || open -a "Terminal"
  "Terminal" : skhd -k "cmd - n"
]
shift + lcmd - return [
  * : open -a "Safari"
  "Safari" : skhd -k "cmd - n"
]
shift + lalt + lcmd - return : osascript -e 'tell application "Safari" to activate' -e 'tell application "System Events" to keystroke "n" using {command down, shift down}'
shift + lcmd - f        : open -a "Finder"
shift + lcmd - m        : open -a "Messages"
shift + lalt + lcmd - m : open -a "Mail"
shift + lcmd - o        : open "obsidian://open?vault=standup"
shift + lcmd - y        : open -a "YouTube"

lcmd - n -> : sleep 1 && kanpai action apply --do
lcmd - t -> : sleep 1 && kanpai action apply --do
lcmd - w -> [
  "Snapmaker Orca" : cmd - q
  * : sleep 1 && kanpai autoquit && { if [[ "$(kanpai info windows --count --appnames)" == $'1\nYouTube' ]]; then kanpai move centre; else kanpai action apply --do; fi; } && [ "$(kanpai info windows --count)" -eq 0 ] && sh ~/.config/kanpai/change_space.sh prev
]

# cycle screen resolution
lcmd - 0x2C : displayplacer id:1\ mode:$(displayplacer list | sed -n '/current mode/{s/.*mode 4.*/5/;s/.*mode 5.*/4/;p;q;}')

# lockscreen
fn - l : skhd -k 'ctrl + cmd - q'; nowplaying-cli pause
