# Measure WAN speed with networkQuality and plot it against familiar markers
speedtest() {
  if ! command -v networkQuality >/dev/null; then
    print -u2 "speedtest: networkQuality not found (macOS only)"
    return 1
  fi

  if ! command -v jq >/dev/null; then
    print -u2 "speedtest: jq not found"
    return 1
  fi

  print -u2 "Testing WAN… this takes roughly 20–40 seconds"

  local json
  json=$(networkQuality -c "$@") || {
    print -u2 "speedtest: networkQuality failed"
    return 1
  }

  local parsed dl ul rtt rpm iface err
  parsed=$(print -r -- "$json" | jq -r '[
    (if .dl_throughput then .dl_throughput * 8 / 1000000 else -1 end),
    (if .ul_throughput then .ul_throughput * 8 / 1000000 else -1 end),
    (.base_rtt // 0),
    (.responsiveness // 0),
    (.interface_name // "?"),
    (.error_code // "")
  ] | @tsv') || {
    print -u2 "speedtest: could not parse networkQuality output"
    return 1
  }

  IFS=$'\t' read -r dl ul rtt rpm iface err <<< "$parsed"

  if [[ "$dl" == "-1" && "$ul" == "-1" ]]; then
    print -u2 "speedtest: networkQuality returned no measurements${err:+ (error $err)}"
    return 1
  fi

  awk -v dl="$dl" -v ul="$ul" -v rtt="$rtt" -v rpm="$rpm" -v iface="$iface" '
    function rep(s, n,   r) { r = ""; while (n-- > 0) r = r s; return r }
    function pos(v) {
      if (v <= LO) return 0
      if (v >= HI) return W - 1
      return int(log(v / LO) / log(10) / SPAN * (W - 1) + 0.5)
    }
    function bar(v,   p) {
      if (v < 0) return ""
      if (v <= 0) return rep("░", W)
      p = pos(v)
      return rep("█", p + 1) rep("░", W - p - 1)
    }
    function speed(v) {
      if (v < 0) return "not tested"
      if (v >= 1000) return sprintf("%.0f Mbps", v)
      return sprintf("%.1f Mbps", v)
    }
    function ticks(   s, i, k, hit) {
      s = ""
      for (i = 0; i < W; i++) {
        hit = 0
        for (k = 1; k <= N; k++)
          if (mark[k] == i) hit = 1
        s = s (hit ? "│" : " ")
      }
      return s
    }
    function labels(   s, k, l, start) {
      s = rep(" ", W)
      for (k = 1; k <= N; k++) {
        l = length(name[k])
        start = mark[k] - int(l / 2)
        if (start < 0) start = 0
        if (start + l > W) start = W - l
        s = substr(s, 1, start) name[k] substr(s, start + l + 1)
      }
      return s
    }
    BEGIN {
      W = 67; LO = 0.05; HI = 16000; SPAN = log(HI / LO) / log(10); N = 10
      split("56k:0.056 8:8 24:24 50:50 100:100 250:250 500:500 1G:1000 2.5G:2500 10G:10000", m, " ")
      for (k = 1; k <= N; k++) {
        split(m[k], a, ":")
        name[k] = a[1]
        mark[k] = pos(a[2])
      }

      printf "%s %10s %s\n", "↓", speed(dl), bar(dl)
      printf "%s %10s %s\n", "↑", speed(ul), bar(ul)
      printf "%13s%s\n", "Mbps", ticks()
      printf "%13s%s\n", "", labels()

      lat = (rtt > 0) ? sprintf("%.1f ms", rtt) : "n/a"
      resp = (rpm > 0) ? sprintf("%.0f RPM", rpm) : "n/a"
      printf "\n  Idle latency %s · Responsiveness %s · %s\n", lat, resp, iface

      print ""
      print "  ### SCALE ###"
      n = split("56k=dial-up;8=3G;24=ADSL2+ / 4G;50=NBN 50;100=NBN 100 / 5G;250=NBN 250;500=Wi-Fi 5;1G=NBN 1000 / gigabit Ethernet / Wi-Fi 6;2.5G=2.5GbE;10G=10GbE", legend, ";")
      for (k = 1; k <= n; k++) {
        split(legend[k], a, "=")
        printf "  %5s   %s\n", a[1], a[2]
      }
    }
  '
}

yt2mp4 () {
  yt-dlp --add-chapters --embed-subs -t mp4 "https://youtu.be/$@"
}

rm() {
  command rm -v "$@" 2>&1 | nl -w2 -s". "
}

cleanup() {
  if [ -x /opt/homebrew/bin/brew ]; then
    brew cleanup --prune=all
  fi

  if [ -x /usr/bin/pacman ]; then
    pacman -Qdtq && sudo pacman -Rns $(pacman -Qdtq) || echo "No orphaned dependancies to prune."
  fi
}

# Use HandBrake to convert MKV to MP4
# First draft for macOS based media soltuions, might use GUI instead
mkv2mp4() {
  for file in *.mkv; do
    HandBrakeCLI -i "$file" -o "${file%.mkv}.mp4" \
      -e x265_10bit \
      -q 18 \
      -E copy \
      --hdr-dynamic-metadata all \
      --keep-metadata
  done
}

# Write iso file to sd card
iso2sd() {
  if (( $# < 1 )); then
    echo "Usage: iso2sd <input_file> [output_device]"
    echo "Example: iso2sd ~/Downloads/ubuntu-25.04-desktop-amd64.iso /dev/sda"
    return 1
  fi

  local iso="$1"
  local drive="$2"

  if [[ -z $drive ]]; then
    echo "No drive selected"
    return 1
  fi

  sudo dd bs=4M status=progress oflag=sync if="$iso" of="$drive"
  sudo eject "$drive"
}

# Format an entire drive for a single partition using exFAT
format-drive() {
  if (( $# != 2 )); then
    echo "Usage: format-drive <device> <name>"
    echo "Example: format-drive /dev/sda 'My Stuff'"
    echo -e "\nAvailable drives:"
    command -v diskutil &>/dev/null && diskutil list | grep /dev/ | awk '{print $1}'
    command -v lsblk &>/dev/null && lsblk -d -o NAME -n | awk '{print "/dev/"$1}'
  else
    echo "WARNING: This will completely erase all data on $1 and label it '$2'."
    read -rp "Are you sure you want to continue? (y/N): " confirm

    if [[ $confirm =~ ^[Yy]$ ]]; then
      sudo wipefs -a "$1"
      sudo dd if=/dev/zero of="$1" bs=1M count=100 status=progress
      sudo parted -s "$1" mklabel gpt
      sudo parted -s "$1" mkpart primary 1MiB 100%
      sudo parted -s "$1" set 1 msftdata on

      partition="$([[ $1 == *"nvme"* ]] && echo "${1}p1" || echo "${1}1")"
      sudo partprobe "$1" || true
      sudo udevadm settle || true

      sudo mkfs.exfat -n "$2" "$partition"

      echo "Drive $1 formatted as exFAT and labeled '$2'."
    fi
  fi
}

# Create a full-disk iso image from an sd card
sd2iso() {
  local compress=0

  if [[ $1 == "--compress" ]]; then
    compress=1
    shift
  fi

  if (( $# < 1 )); then
    echo "Usage: sd2iso [--compress] <input_device> [output_file]"
    echo "Example: sd2iso /dev/sda ~/backups/sd-image.iso"
    echo "         sd2iso --compress /dev/sda ~/backups/sd-image.iso.gz"
    return 1
  fi

  local drive="$1"
  local out
  if [[ -n $2 ]]; then
    out="$2"
  elif (( compress )); then
    out="./sd-image-$(date +%Y%m%d-%H%M%S).iso.gz"
  else
    out="./sd-image-$(date +%Y%m%d-%H%M%S).iso"
  fi

  if (( compress )); then
    command -v gzip >/dev/null || { echo "gzip not found"; return 1; }
    sudo dd bs=4M status=progress if="$drive" | gzip > "$out"
  else
    sudo dd bs=4M status=progress if="$drive" of="$out"
  fi

  echo "Wrote $out"
}

# Transcode a video to a good-balance 1080p that's great for sharing online
transcode-video-1080p() {
  ffmpeg -i "$1" -vf scale=1920:1080 -c:v libx264 -preset fast -crf 23 -c:a copy "${1%.*}-1080p.mp4"
}

# Transcode a video to a good-balance 4K that's great for sharing online
transcode-video-4K() {
  ffmpeg -i "$1" -c:v libx265 -preset slow -crf 24 -c:a aac -b:a 192k "${1%.*}-optimized.mp4"
}

# Transcode any image to JPG image that's great for shrinking wallpapers
img2jpg() {
  img="$1"
  shift

  magick "$img" "$@" -quality 95 -strip "${img%.*}-converted.jpg"
}

# Transcode any image to a small JPG (max 1080px wide) that's great for sharing online
img2jpg-small() {
  img="$1"
  shift

  magick "$img" "$@" -resize 1080x\> -quality 95 -strip "${img%.*}-small.jpg"
}

# Transcode any image to a medium JPG (max 1800px wide) that's great for sharing online
img2jpg-medium() {
  img="$1"
  shift

  magick "$img" "$@" -resize 1800x\> -quality 95 -strip "${img%.*}-medium.jpg"
}

# Transcode any image to compressed-but-lossless PNG
img2png() {
  img="$1"
  shift

  magick "$img" "$@" -strip -define png:compression-filter=5 \
    -define png:compression-level=9 \
    -define png:compression-strategy=1 \
    -define png:exclude-chunk=all \
    "${img%.*}-optimized.png"
}

# Transcode any image to compressed-but-lossless PNG
img2png() {
  img="$1"
  shift

  magick "$img" $@ -strip -define png:compression-filter=5 \
    -define png:compression-level=9 \
    -define png:compression-strategy=1 \
    -define png:exclude-chunk=all \
    "${img%.*}-optimized.png"
}

# SSH Port Forwarding Functions
fip() {
  (( $# < 2 )) && echo "Usage: fip <host> <port1> [port2] ..." && return 1
  local host="$1"
  shift
  for port in "$@"; do
    ssh -f -N -L "$port:localhost:$port" "$host" && echo "Forwarding localhost:$port -> $host:$port"
  done
}

dip() {
  (( $# == 0 )) && echo "Usage: dip <port1> [port2] ..." && return 1
  for port in "$@"; do
    pkill -f "ssh.*-L $port:localhost:$port" && echo "Stopped forwarding port $port" || echo "No forwarding on port $port"
  done
}

lip() {
  pgrep -af "ssh.*-L [0-9]+:localhost:[0-9]+" || echo "No active forwards"
}

# Create a new worktree and branch from within current git directory.
ga() {
  if [[ -z "$1" ]]; then
    echo "Usage: ga [branch name]"
    return 1
  fi

  local branch="$1"
  local base="$(basename "$PWD")"
  local path="../${base}--${branch}"

  git worktree add -b "$branch" "$path"
  mise trust "$path"
  cd "$path"
}

# Remove worktree and branch from within active worktree directory.
gd() {
  if gum confirm "Remove worktree and branch?"; then
    local cwd base branch root worktree

    cwd="$(pwd)"
    worktree="$(basename "$cwd")"

    # split on first `--`
    root="${worktree%%--*}"
    branch="${worktree#*--}"

    # Protect against accidentally nuking a non-worktree directory
    if [[ "$root" != "$worktree" ]]; then
      cd "../$root"
      git worktree remove "$cwd" --force || return 1
      git branch -D "$branch"
    fi
  fi
}

# Set git user.name and user.email
git-id() {
  git config --global user.name "$(gum input --placeholder 'Name' --header 'Git name')"
  git config --global user.email "$(gum input --placeholder 'Email' --header 'Git email')"
}
